# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server only, never expose to the client.
# Used for admin coin grants / machine webhook ingestion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the physical ATZAR machine uses to post play results
# to /api/machine/submit. Rotate if ever leaked.
MACHINE_API_SECRET=f0bfef6c0acdd2fa3a1937861d60055ef794a0025a65e3a017e795a7be58d162
